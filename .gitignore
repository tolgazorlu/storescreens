# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/uploads
data/
public/bezels/*.png

# large script fonts, fetched by scripts/fetch-fonts.sh
/public/fonts/NotoSansSC-*.ttf
/public/fonts/NotoSansTC-*.ttf
/public/fonts/NotoSansJP-*.ttf
/public/fonts/NotoSansKR-*.ttf
/public/fonts/NotoSansDevanagari-*.ttf
/public/fonts/NotoSansBengali-*.ttf

# Pattern Craft background images, fetched by scripts/fetch-patterns.sh (manifest.json is kept)
public/patterns/*.png
