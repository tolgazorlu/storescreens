# Postgres connection string (Vercel Postgres / Neon or local)
DATABASE_URL=postgres://localhost:5432/screeny
# Random 32+ char string, signs session cookies
SESSION_SECRET=change-me
# Optional: Vercel Blob. When unset, uploads go to public/uploads (dev only)
BLOB_READ_WRITE_TOKEN=
# Optional: public origin used in absolute URLs returned to agents
APP_URL=http://localhost:3000
