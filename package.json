{
  "name": "storeframe",
  "version": "0.1.0",
  "description": "Local App Store and Google Play screenshot generator: in-app screenshots and a logo in, store-ready PNGs per locale and device out. Editor, REST and MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tolgazorlu/storeframe.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4110",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4110",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "TSX_TSCONFIG_PATH=tsconfig.scripts.json tsx scripts/smoke-render.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "mcp-handler": "^2.2.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satori": "^0.33.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "fflate@<0.7.5": "0.7.5"
    }
  }
}
